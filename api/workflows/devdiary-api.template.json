    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet markdown = '# DevDiary Export\\n\\n';\n\nfor (const item of items) {\n  const entry = item.json;\n\n  markdown += `## ${entry.title ?? 'Senza titolo'}\\n\\n`;\n  markdown += `**Tipo:** ${entry.type ?? 'note'}\\n\\n`;\n\n  if (Array.isArray(entry.tags) && entry.tags.length > 0) {\n    markdown += `**Tag:** ${entry.tags.map(tag => `#${tag}`).join(' ')}\\n\\n`;\n  }\n\n  markdown += `${entry.content ?? ''}\\n\\n`;\n\n  if (entry.language) {\n    markdown += `**Linguaggio:** ${entry.language}\\n\\n`;\n  }\n\n  if (entry.code) {\n    markdown += '```' + (entry.language ?? '') + '\\n';\n    markdown += entry.code + '\\n';\n    markdown += '```\\n\\n';\n  }\n\n  markdown += '---\\n\\n';\n}\n\nreturn [\n  {\n    json: {\n      markdown\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
