    {
      "parameters": {
        "jsCode": "const id = $json.query?.id;\nconst body = $json.body ?? {};\n\nconst validTypes = [\"note\", \"snippet\", \"idea\", \"errore\", \"link\"];\n\nif (!id) {\n  return [{\n    json: {\n      error: true,\n      message: \"Parametro id obbligatorio\"\n    }\n  }];\n}\n\nif (!/^[a-fA-F0-9]{24}$/.test(id)) {\n  return [{\n    json: {\n      error: true,\n      message: \"ID non valido\"\n    }\n  }];\n}\n\nconst title = String(body.title ?? \"\").trim();\nconst content = String(body.content ?? \"\").trim();\nconst type = String(body.type ?? \"note\").trim().toLowerCase();\n\nif (!title) {\n  return [{\n    json: {\n      error: true,\n      message: \"Il titolo è obbligatorio\"\n    }\n  }];\n}\n\nif (!content) {\n  return [{\n    json: {\n      error: true,\n      message: \"Il contenuto è obbligatorio\"\n    }\n  }];\n}\n\nif (!validTypes.includes(type)) {\n  return [{\n    json: {\n      error: true,\n      message: \"Tipo non valido\"\n    }\n  }];\n}\n\nlet tags = body.tags ?? [];\n\nif (typeof tags === \"string\") {\n  tags = tags.split(\",\");\n}\n\nif (!Array.isArray(tags)) {\n  tags = [];\n}\n\ntags = tags\n  .map(tag => String(tag).trim().toLowerCase())\n  .filter(tag => tag.length > 0);\n\nreturn [{\n  json: {\n    error: false,\n    _id: id,\n    title,\n    content,\n    type,\n    language: body.language ?? null,\n    code: body.code ?? null,\n    tags,\n    isFavorite: body.isFavorite === true,\n    updatedAt: new Date().toISOString()\n  }\n}];"
      },
