    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\n// Validazione titolo e content obbligatori\nif (!body.title || body.title.toString().trim() === '') {\n  return [{\n    json: {\n      error: true,\n      message: \"Il titolo è obbligatorio\"\n    }\n  }];\n}\n\nif (!body.content || body.content.toString().trim() === '') {\n  return [{\n    json: {\n      error: true,\n      message: \"Il contenuto è obbligatorio\"\n    }\n  }];\n}\n\n// Validazione type\nconst allowedTypes = ['note', 'snippet', 'idea', 'errore', 'link'];\n\nlet type = (body.type ?? 'note')\n  .toString()\n  .trim()\n  .toLowerCase();\n\nif (type === '') {\n  type = 'note';\n}\n\nif (!allowedTypes.includes(type)) {\n  return [{\n    json: {\n      error: true,\n      message: \"Type non valido\"\n    }\n  }];\n}\n\n// Normalizzazione tags\nlet tags = body.tags ?? [];\n\nif (typeof tags === 'string') {\n  tags = tags.split(',');\n}\n\ntags = tags\n  .map(tag => tag.toString().trim().toLowerCase())\n  .filter(tag => tag.length > 0);\n\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    title: body.title.toString().trim(),\n    content: body.content.toString().trim(),\n    type,\n    language: body.language ?? null,\n    code: body.code ?? null,\n    tags,\n    isFavorite: body.isFavorite ?? false,\n    createdAt: now,\n    updatedAt: now\n  }\n}];"
      },
