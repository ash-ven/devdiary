    {
      "parameters": {
        "jsCode": "const query = $json.query ?? {};\n\nconst filter = {};\n\n// filtro per type\nif (query.type) {\n  filter.type = query.type.toString().trim().toLowerCase();\n}\n\n// filtro preferiti\nif (query.favorite !== undefined && query.favorite !== '') {\n  filter.isFavorite = query.favorite.toString().toLowerCase() === 'true';\n}\n\n// filtro per tag\nif (query.tag) {\n  filter.tags = query.tag.toString().trim().toLowerCase();\n}\n\n// ricerca in titolo oppure contenuto\nif (query.search) {\n  const search = query.search.toString().trim();\n\n  filter.$or = [\n    {\n      title: {\n        $regex: search,\n        $options: 'i'\n      }\n    },\n    {\n      content: {\n        $regex: search,\n        $options: 'i'\n      }\n    }\n  ];\n}\n\nreturn [{\n  json: {\n    filter\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        336
      ],
      "id": "27e50e2f-d0a1-46f1-b7b4-ae3265116b06",
      "name": "Build Diary Filter"
    },
