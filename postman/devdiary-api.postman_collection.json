      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const ct = pm.response.headers.get('Content-Type') || '';",
          "if (ct.includes('json')) pm.test('nessun ownerId nella risposta', () => pm.expect(pm.response.text()).to.not.include('ownerId'));"
        ]
      }
    }
  ],
